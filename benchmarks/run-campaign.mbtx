import {
  "moonbitlang/async@0.21.3",
  "moonbitlang/async@0.21.3/process",
  "moonbitlang/async@0.21.3/shell",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
  "moonbitlang/x@0.5.5/fs",
}

fn command_label(name : String, program : String, args : Array[String]) -> String {
  "\{name}: program \{program} args [\{args.join(" ")}]"
}

async fn invoke(name : String, program : String, args : Array[String], limit : Int) -> Int {
  let base = "benchmark-results/logs/" + name
  @fs.write_string_to_file(base + ".command.json", ({ "program": program, "args": args.to_json() } : Json).stringify())
  let stdout = @process.redirect_to_file(base + ".stdout.txt")
  let stderr = @process.redirect_to_file(base + ".stderr.txt")
  let result : Result[Int, Error] = try {
    Ok(@async.with_timeout(limit, () => @process.run(program, args[:], stdout~, stderr~, cancel_handler=@process.hard_cancel())))
  } catch { error => Err(error) }
  match result {
    Ok(code) => {
      @fs.write_string_to_file(base + ".status.json", ({ "exit_code": code } : Json).stringify())
      code
    }
    Err(error) => {
      @fs.write_string_to_file(base + ".status.json", ({ "error": "\{error}" } : Json).stringify())
      fail("\{command_label(name, program, args)} failed to start; raw error: \{error}")
    }
  }
}

async fn checked(name : String, program : String, args : Array[String], limit? : Int = 300000) -> Unit {
  let code = invoke(name, program, args, limit)
  guard code == 0 else { fail("\{command_label(name, program, args)}: exit \{code}; see benchmark-results/logs/\{name}.*") }
}

fn save_state(status : String, smoke : Bool, repetitions : Int, message : String) -> Unit raise {
  @fs.write_string_to_file("benchmark-results/campaign.json", ({ "version": 2, "status": status, "smoke": smoke, "repetitions": repetitions, "message": message, "runtimes": ["native", "moonx-wasm"] } : Json).stringify(indent=2))
}

async fn main {
  let args = @env.args()
  guard args.length() == 1 || (args.length() == 2 && args[1] == "smoke") else { fail("usage: moonx benchmarks/run-campaign.mbtx [smoke]") }
  let smoke = args.length() == 2
  let repetitions = if smoke { 1 } else { 5 }
  if !@fs.path_exists("benchmark-results") { @fs.create_dir("benchmark-results") }
  guard !@fs.path_exists("benchmark-results/runs") && !@fs.path_exists("benchmark-results/logs") else { fail("campaign artifacts already exist; move or remove the old campaign before running again") }
  @fs.create_dir("benchmark-results/logs")
  @fs.create_dir("benchmark-results/runs")
  @fs.create_dir("benchmark-results/runs/native")
  @fs.create_dir("benchmark-results/runs/moonx-wasm")
  save_state("incomplete", smoke, repetitions, "campaign has not finished")
  let outcome : Result[Unit, Error] = try { Ok({
    checked("toolchain", "moon", ["version", "--all"])
    checked("environment", "uname", ["-a"])
    checked("revision", "git", ["rev-parse", "HEAD"])
    checked("tree-status", "git", ["status", "--porcelain"])
    checked("fetch", "moonx", ["benchmarks/fetch-suite.mbtx"])
    checked("prepare", "moonx", ["benchmarks/prepare-suite.mbtx"])
    checked("dependencies", "moon", ["tree"])
    checked("check", "moon", ["check", "--target", "native", "--deny-warn", "--output-json"])
    checked("unit-tests", "moon", ["test", "--target", "native", "--deny-warn", "--output-json"])
    checked("build-conformance", "moon", ["build", "cmd/conformance", "--target", "native", "--release", "--deny-warn", "--output-json"])
    checked("build-benchmark", "moon", ["build", "cmd/benchmark", "--target", "native", "--release", "--deny-warn", "--output-json"])
    checked("check-wasm", "moon", ["check", "--target", "wasm", "--deny-warn", "--output-json"])
    checked("prepare-moonx", "moonx", ["benchmarks/prepare-moonx.mbtx"])
    checked("harness-probes", "moonx", ["benchmarks/verify-harness.mbtx"])
    if @fs.path_exists("benchmark-results/conformance.json") { @fs.remove_file("benchmark-results/conformance.json") }
    let code = invoke("conformance", "moon", ["run", "cmd/conformance", "--target", "native", "--release", "--deny-warn", "--output-json", "--", "--manifest", "benchmark-results/manifest.json", "--output", "benchmark-results/conformance.json"], 300000)
    guard code == 0 || code == 1 else { fail("conformance harness failed: exit \{code}") }
    guard @fs.path_exists("benchmark-results/conformance.json") else { fail("conformance report missing") }
    let scenarios = ["official_compile", "official_validate", "official_compile_validate", "official_diagnostics", "tool_arguments", "structured_result", "array1024", "unique128", "branches", "exact_decimal", "pattern"]
    for repetition in 0..<repetitions {
      for offset in 0..<scenarios.length() {
        let scenario = scenarios[(offset + repetition) % scenarios.length()]
        let name = scenario + "-" + (repetition + 1).to_string()
        let runtimes = if (offset + repetition) % 2 == 0 {
          ["native", "moonx-wasm"]
        } else { ["moonx-wasm", "native"] }
        for runtime in runtimes {
          let output = "benchmark-results/runs/" + runtime + "/" + name + ".json"
          let argv = ["--manifest", "benchmark-results/manifest.json", "--conformance", "benchmark-results/conformance.json", "--output", output, "--scenario", scenario]
          if smoke { argv.push("--smoke") }
          let (program, prefix) = if runtime == "native" {
            ("moon", ["run", "cmd/benchmark", "--target", "native", "--release", "--deny-warn", "--output-json", "--"])
          } else { ("moonx", ["benchmark-results/measurement.mbtx"]) }
          println("\{runtime}: \{name}")
          checked(runtime + "-" + name, program, prefix + argv, limit=120000)
          guard @fs.path_exists(output) else { fail("measurement report missing: " + runtime + "/" + name) }
        }
      }
    }
    save_state("complete", smoke, repetitions, "both native and moonx-Wasm measurements completed; conformance gaps remain visible in x/N")
    checked("summary", "moonx", ["benchmarks/report.mbtx"])
    checked("report-probes", "moonx", ["benchmarks/verify-report.mbtx"])
  }) } catch { error => Err(error) }
  match outcome {
    Ok(_) => ()
    Err(error) => {
      save_state("incomplete", smoke, repetitions, "\{error}")
      // Best-effort summary cannot replace or swallow the original failure.
      let summary = @shell.Cmd("moonx", ["benchmarks/report.mbtx"]).status(timeout_ms=60000) catch { secondary => { println("fallback summary failed to start (program moonx args [benchmarks/report.mbtx]): \{secondary}"); -1 } }
      if summary != 0 { println("fallback summary (program moonx args [benchmarks/report.mbtx]) exit \{summary}; original failure retained") }
      raise error
    }
  }
}
