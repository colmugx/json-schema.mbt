import {
  "colmugx/json-schema" @schema,
  "moonbitlang/core/env",
  "moonbitlang/core/string",
  "moonbitlang/x/fs",
  "moonbitlang/x/sys",
}

pkgtype(kind: "executable")

supported_targets = "native + js + wasm"

options(
  targets: {
    "arguments.mbt": [ "native", "wasm" ],
    "arguments_js.mbt": [ "js" ],
  },
)
